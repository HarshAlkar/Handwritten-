# Paths relative to project root (or absolute)
MODEL_PATH=ML/artifacts/digit_cnn.keras
HISTORY_PATH=ML/artifacts/history.json
METRICS_PATH=ML/artifacts/metrics.json

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max upload size in bytes (default 2 MB)
MAX_UPLOAD_BYTES=2097152

# Training defaults (optional overrides for train script)
EPOCHS=10
BATCH_SIZE=128
LEARNING_RATE=0.001
RANDOM_SEED=42
VALIDATION_SPLIT=0.1
